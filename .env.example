# Copy to .env and set for your environment.
# EXPO_PUBLIC_ variables are inlined into the bundle at build time,
# so never put a secret here — this is a public value by design.

# Base URL of the CRM backend, including /api
# Local dev against a machine on the same network (not localhost — the
# device cannot reach the dev machine's loopback):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api
# Android emulator reaching the host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
EXPO_PUBLIC_API_URL=https://khan-expert-backend.onrender.com/api

# Support number shown on the login screen when sign-in fails repeatedly
EXPO_PUBLIC_SUPPORT_PHONE=
