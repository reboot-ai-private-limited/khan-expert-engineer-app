{
  "expo": {
    "name": "Khan Expert Engineer",
    "slug": "khanexpert-engineer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "khanexpert",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#047857"
    },
    "android": {
      "package": "in.khanexpert.engineer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#047857"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "in.khanexpert.engineer",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
